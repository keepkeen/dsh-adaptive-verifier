# Only required when explicitly using the provider-specific `deepseek-logprob`
# verifier backend or the standalone CLI. Normal Harness-native verification
# goes through ctx.llm and never reads provider API keys in this plugin.
DSH_VERIFIER_DEEPSEEK_API_KEY=

# Optional only for explicit DeepSeek HTTP/logprob mode.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
