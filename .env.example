# Only required when explicitly using the provider-specific `deepseek-logprob`
# backend or the standalone CLI. Normal Harness-native verification uses the
# selected Harness provider and does not read provider API keys itself.
DEEPSEEK_API_KEY=

# Optional only for explicit DeepSeek HTTP/logprob mode.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
